# 本機開發用範例。複製為 .env 後填入真實值；.env 不可提交。
# Docker Compose 雲端部署另需 POSTGRES_DB、POSTGRES_USER、POSTGRES_PASSWORD，
# 且 DATABASE_URL 的 host 是 `db`；產生方式見 docs/DEPLOYMENT.md。
# 產生密碼雜湊：npm run auth:hash
NODE_ENV=development
PORT=3000

# PostgreSQL 連線。資料庫需先建立，然後執行 npm run db:migrate。
DATABASE_URL=postgres://ppm:CHANGE_ME@127.0.0.1:5432/personal_project_manager

# 開發時由 Vite 提供介面，瀏覽器來源是 5173；/api 會代理至 3000。
# 正式部署時改成你的 HTTPS 網域，例如 https://ppm.example.com
PUBLIC_ORIGIN=http://127.0.0.1:5173

# npm run auth:hash 的輸出。以下只是佔位字串，不能用來登入，必須整個替換。
ADMIN_PASSWORD_HASH=replace-with-output-of-npm-run-auth-hash

# 至少 32 個字元的隨機字串，例如用密碼管理器產生。不可使用本檔的佔位值。
SESSION_SECRET=replace-with-at-least-32-random-characters

# 直接在本機執行時為 0；放在反向代理之後時填實際的代理層數。
TRUST_PROXY_HOPS=0
