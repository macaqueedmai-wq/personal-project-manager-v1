{
  "name": "personal-project-manager",
  "version": "0.1.0",
  "private": true,
  "description": "個人工作台：單一使用者的項目、任務與生活領域管理平台",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && node scripts/clean.mjs && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration --no-file-parallelism",
    "test:e2e": "npm run build && playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:hash": "tsx scripts/auth-hash.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "bcryptjs": "3.0.3",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
